# Copier en .env pour personnaliser. Facultatif : docker-compose.yml fournit des valeurs par défaut.
# Données 100 % fictives : ces secrets ne servent qu'au prototype.

# Ports exposés sur la machine
FRONT_PORT=5173
API_PORT=8000
ANIP_PORT=8001
CENTRES_PORT=8002
PHARMACIES_PORT=8003
MEDECINS_PORT=8004
BLOCKCHAIN_PORT=3000
HARDHAT_PORT=8545
MYSQL_PORT=3307
MAILPIT_PORT=8025

# URL de l'API vue depuis le NAVIGATEUR. Pour tester sur smartphone, mettre l'IP du PC :
# VITE_API_URL=http://192.168.1.20:8000/api   (et CORS : voir README)
# VITE_API_URL=http://localhost:8000/api

# MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=dmp
MYSQL_USER=dmp
MYSQL_PASSWORD=dmp_password

# Laravel (API du DMP). APP_KEY chiffre les données au repos : ne pas la changer une fois des données créées.
APP_ENV=local
APP_DEBUG=true
# APP_KEY=base64:...                 # générer : docker compose run --rm api-dmp php artisan key:generate --show
# PSEUDONYM_SECRET=...               # clé HMAC des pseudonymes (RG-09)
RUN_SEEDERS=true

# Blockchain : clé du compte n°0 de Hardhat (publique, connue de tous : usage local uniquement)
# BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
